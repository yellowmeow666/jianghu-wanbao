.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #1c1915;
  color: #f3efe6;
  box-shadow: 0 -8rpx 24rpx rgba(28, 25, 21, 0.12);
}

.label {
  flex: none;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(243, 239, 230, 0.45);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hint {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.4;
}
