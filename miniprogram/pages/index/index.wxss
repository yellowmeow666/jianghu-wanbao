.page {
  padding: 32rpx 32rpx 180rpx;
}

.masthead {
  padding-bottom: 28rpx;
  border-bottom: 4rpx solid #1c1915;
}

.kicker {
  display: block;
  color: #9a3b2f;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 64rpx;
  line-height: 1.15;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 12rpx;
  color: #6e675c;
  font-size: 24rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  border: 1rpx solid #d9d0c0;
  background: transparent;
  color: #6e675c;
}

.tab-on {
  background: #1c1915;
  border-color: #1c1915;
  color: #f3efe6;
}

.state {
  padding: 72rpx 12rpx;
  text-align: center;
}

.state-title,
.state-desc,
.state-code {
  display: block;
}

.state-title {
  font-size: 34rpx;
}

.state-desc {
  margin-top: 12rpx;
  color: #6e675c;
}

.state-code {
  margin-top: 8rpx;
  color: #9a3b2f;
  font-size: 22rpx;
}

.retry {
  display: inline-block;
  margin-top: 28rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #1c1915;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  padding: 28rpx;
  background: #fffdf8;
  border: 1rpx solid #e4dccb;
}

.card-hover {
  background: #f7f1e6;
}

.card-top,
.card-title,
.card-summary,
.card-source {
  display: block;
}

.card-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
}

.badge {
  padding: 2rpx 10rpx;
  font-size: 22rpx;
}

.badge-yes {
  color: #245c40;
  background: #e5f2ea;
}

.badge-no {
  color: #8a6232;
  background: #f6ead8;
}

.time,
.card-source {
  color: #6e675c;
  font-size: 22rpx;
}

.card-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  line-height: 1.35;
}

.card-summary {
  margin-top: 10rpx;
  color: #3d3832;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-source {
  margin-top: 16rpx;
}
