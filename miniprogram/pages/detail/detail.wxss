.page {
  padding: 36rpx 32rpx 180rpx;
}

.kicker,
.title,
.summary,
.section-title,
.source,
.note,
.state-title,
.state-desc,
.state-code,
.node-time,
.node-text {
  display: block;
}

.kicker {
  color: #9a3b2f;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 600;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: center;
  margin-top: 20rpx;
}

.badge {
  padding: 2rpx 10rpx;
  font-size: 22rpx;
}

.badge-yes {
  color: #245c40;
  background: #e5f2ea;
}

.badge-no {
  color: #8a6232;
  background: #f6ead8;
}

.muted,
.note,
.field-value {
  color: #6e675c;
  font-size: 24rpx;
}

.fields {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label,
.field-value {
  display: block;
}

.field-label {
  color: #9a3b2f;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.field-value {
  margin-top: 4rpx;
  color: #1c1915;
  font-size: 28rpx;
}

.summary {
  margin-top: 28rpx;
  font-size: 32rpx;
  line-height: 1.7;
}

.section {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e4dccb;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.node {
  position: relative;
  padding: 0 0 28rpx 28rpx;
  border-left: 2rpx solid #d9d0c0;
}

.node::before {
  content: "";
  position: absolute;
  left: -7rpx;
  top: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9a3b2f;
}

.node-time {
  color: #9a3b2f;
  font-size: 22rpx;
}

.node-text {
  margin-top: 6rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.note {
  margin-top: 16rpx;
}

.state {
  padding: 80rpx 8rpx;
  text-align: center;
}

.state-desc {
  margin-top: 12rpx;
  color: #6e675c;
}

.state-code {
  margin-top: 8rpx;
  color: #9a3b2f;
  font-size: 22rpx;
}

.retry {
  display: inline-block;
  margin-top: 28rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #1c1915;
}
