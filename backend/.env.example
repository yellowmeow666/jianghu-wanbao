PORT=3000
ADMIN_TOKEN=change-me-to-a-long-secret
# mysql://user:password@host:port/database
DATABASE_URL=mysql://jianghu:jianghu@127.0.0.1:3306/jianghu_wanbao
# Admin ingest endpoints: max requests per token per minute
INGEST_RATE_LIMIT=10
# 写入加密贴吧 Cookie 时必填。必须是 32 字节：64 位 hex，或解码后 32 字节的 base64。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 下面是占位，不能直接用来加密。CI 使用 ci-cookie-encryption-key-not-for-prod，不读这个示例值。
COOKIE_ENCRYPTION_KEY=change-me-to-a-long-secret
# 可选：加密 Cookie 文件路径。相对路径相对进程 cwd。不设则用 backend/data/tieba-cookie.enc。
# TIEBA_COOKIE_STORE=data/tieba-cookie.enc
